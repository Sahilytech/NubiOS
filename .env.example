# NubiOS runtime
NUBIOS_MOCK_AI=true
NUBIOS_AI_PROVIDER=mock
NUBIOS_DATA_DIR=./nubios_data
NUBIOS_ALLOWED_DIRECTORIES=
NUBIOS_LOG_LEVEL=INFO

# Real AI (set NUBIOS_MOCK_AI=false and NUBIOS_AI_PROVIDER=openai)
OPENAI_API_KEY=
NUBIOS_OPENAI_MODEL=gpt-4o-mini
NUBIOS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional voice — imports/models are loaded only when used
NUBIOS_VOICE_ENABLED=false
NUBIOS_WHISPER_MODEL=tiny
NUBIOS_TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
